# VANTAGE Intelligence Platform Environment Variables (Example Placeholders)
# Keep all secret API keys strictly on the server; never expose in client bundles.

# App Configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider Keys (Optional: when unconfigured, platform operates in high-fidelity demo mode)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Search & Research APIs (Optional)
TAVILY_API_KEY=your_tavily_search_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Database / Storage (Optional: PostgreSQL / Supabase for cloud persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/vantage
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
